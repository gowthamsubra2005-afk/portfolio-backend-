# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Connect your application
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/gowtham_portfolio?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Admin Authentication
ADMIN_EMAIL=gowthamsubra31@gmail.com
# Use a precomputed bcrypt hash of your admin password or set ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend URL for CORS (your Vercel app domain)
# Example: https://portfolio-gowtham.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app
